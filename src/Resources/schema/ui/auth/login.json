{
  "formSchema": {
    "method": "POST",
    "action": "route('login')",
    "enctype": ""
  },
  "dataSchema": {
    "_token": { "type": "string", "required": true },
    "email": { "type": "email", "required": true },
    "password": { "type": "string", "required": true },
    "remember": { "type": "boolean", "required": false }
  },
  "uiSchema": {
    "layout": "vertical",
    "elements": [
      {
        "type": "hidden",
        "field": "_token",
        "value": "csrf"
      },
      {
        "type": "input",
        "field": "email",
        "label": "E-Mail Address",
        "autocomplete": "email"
      },
      {
        "type": "input",
        "field": "password",
        "label": "Password",
        "autocomplete": "current-password"
      },
      {
        "type": "checkbox",
        "field": "remember",
        "label": "Remember Me"
      },
      {
        "type": "button",
        "action": "submit",
        "label": "Login"
      }
    ]
  },
  "anmeldungPer": {
    "config": "userauth.anmeldung_per",
    "beschreibung": "Feld der Kennung je Modus; ersetzt das Feld email in dataSchema und uiSchema. Standard: email.",
    "email": {
      "field": "email",
      "dataSchema": { "type": "email", "required": true },
      "ui": { "type": "input", "inputType": "email", "label": "E-Mail Address", "autocomplete": "email" }
    },
    "benutzername": {
      "field": "benutzername",
      "dataSchema": { "type": "string", "required": true },
      "ui": { "type": "input", "inputType": "text", "label": "userauth::login.kennung_benutzername", "autocomplete": "username" }
    },
    "beides": {
      "field": "login",
      "dataSchema": { "type": "string", "required": true },
      "ui": { "type": "input", "inputType": "text", "label": "userauth::login.kennung_beides", "autocomplete": "username" }
    }
  }
}
