{
    "name": "ithilbert/userauth",
    "type": "library",
    "license": "MIT",
    "description": "User Auth system with Roles, Permissions, 2FA, Audit-Log, Teams.",
    "keywords": [
        "it-hilbert",
        "laravel",
        "permissions",
        "roles",
        "user",
        "security",
        "2fa"
    ],
    "authors": [{
        "name": "Jörg Hilbert",
        "homepage": "https://www.it-hilbert.com",
        "role": "Developer"
    }],
    "homepage": "https://github.com/ITHilbert/userauth",
    "minimum-stability": "stable",
    "require": {
        "php": "^8.5",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/auth": "^12.0 || ^13.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/mail": "^12.0 || ^13.0",
        "illuminate/validation": "^12.0 || ^13.0",
        "ithilbert/laravel-kit": "^1.1",
        "laravel/socialite": "^5.0",
        "nesbot/carbon": "^2.0 || ^3.0",
        "yajra/laravel-datatables-oracle": "^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "ITHilbert\\UserAuth\\": "src/",
            "ITHilbert\\UserAuth\\Database\\Seeds\\": "src/Database/Seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ITHilbert\\UserAuth\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ITHilbert\\UserAuth\\UserAuthServiceProvider"
            ],
            "aliases": {}
        }
    }
}
